# Copy to .env and fill in. Never commit the real .env file.

# --- Live-sending switches -------------------------------------------
# These are a second, independent layer of protection on top of the
# "Enable Email Sending" / "Enable Voice Automation" rows in the
# Settings tab of the Google Sheet. Both layers must be explicitly
# turned on before anything can actually send. Keep both OFF until
# Phase 10 sign-off.
ENABLE_EMAIL_SENDING=false
ENABLE_VOICE_AUTOMATION=false

# Separate and more dangerous than ENABLE_VOICE_AUTOMATION above: when
# true, src/voice/autoSendGoogleVoiceMessage.js clicks Send itself,
# with no operator confirmation. Added 2026-07-23 on explicit request --
# read docs/AUTO_MODE_RISKS.md before setting this to true.
ENABLE_AUTO_SMS_SEND=false

# Same idea as ENABLE_AUTO_SMS_SEND above, but for the REI BlackBook
# Chat channel (src/reiblackbook/autoSendReiBlackBookMessage.js)
# instead of Google Voice. Independent of every other flag here.
ENABLE_REI_SMS_SEND=false

# How often (in minutes) the continuous automation loop
# (app/automationLoop.js) repeats its full cycle -- auto-queue from
# Flip Scout Leads, validate, submit/approve, REI BlackBook
# enrich/notes/replies/send, email send, and (if
# ENABLE_VOICE_AUTOMATION is on) Google Voice. Adjustable from the
# Settings tab in the app; this is just the on-disk default.
AUTOMATION_CYCLE_MINUTES=15

# --- Google Sheets access (service account) ---------------------------
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Sender / campaign identity ---------------------------------------
# Mirrors the Settings tab -- see docs/OPEN_ITEMS.md for what still
# needs sign-off before these are real values.
SENDER_NAME=
SENDER_PHONE=
SENDER_EMAIL=
HANDOFF_PERSON=
COMPANY_WEBSITE=
YEARS_IN_BUSINESS=
GOOGLE_REVIEW_LINK=

# --- Google Voice (Phase 7) ---------------------------------------------
# The Google account whose Google Voice inbox Playwright should open.
# Authentication is via a persisted browser profile (see
# src/voice/prepareGoogleVoiceMessage.js) -- no password is stored here.
GOOGLE_VOICE_PROFILE_DIR=./.voice-profile

# --- Redfin scraping (Phase 3 agent-contact enrichment) -----------------
# Delay between page fetches, in milliseconds. Kept deliberately
# conservative -- see docs/AUTO_MODE_RISKS.md.
REDFIN_SCRAPE_DELAY_MS=5000

# --- Gmail (sending from the desktop app, not Apps Script) ---------------
# One-time setup: Google Cloud Console -> enable the Gmail API -> create
# an OAuth client of type "Desktop app" -> download its JSON to the path
# below -> run `npm run gmail:authorize` once. See README.md.
GMAIL_OAUTH_CLIENT_PATH=./gmail-oauth-client.json
GMAIL_TOKEN_PATH=./gmail-token.json

# --- Google Chat notifications (positive/opt-out reply alerts) -----------
# Incoming webhook URL for a Google Chat space: open the space -> space
# name -> Apps & integrations -> Webhooks -> add one -> copy its URL here.
# Used by checkReplies() (npm run check-replies) to post when an agent
# replies YES or NO -- no OAuth needed for this one.
GOOGLE_CHAT_WEBHOOK_URL=
