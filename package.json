{
  "name": "flip-scout-outreach-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Outreach automation layer that runs after Bryan updates the Flip Scout Leads sheet: validation, versioned templates, human approval, guarded Gmail sending, and Playwright-assisted (send-gated) Google Voice SMS prep.",
  "main": "app/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:apps-script": "node scripts/build-apps-script.js",
    "voice:prepare": "node src/voice/prepareGoogleVoiceMessage.js",
    "voice:autosend": "node src/voice/autoSendGoogleVoiceMessage.js",
    "redfin:enrich": "node src/redfin/enrichAgentContacts.js",
    "app": "electron .",
    "app:web": "node app/server.js",
    "dist:win": "electron-builder --win --dir"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "googleapis": "^140.0.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.twinhomebuyer.outreachcontrolpanel",
    "productName": "Outreach Control Panel",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "shared/**/*",
      "templates/**/*",
      "package.json",
      "node_modules/**/*",
      "!.git",
      "!.github",
      "!tests",
      "!docs",
      "!apps-script",
      "!sample-data",
      "!dist",
      "!.env",
      "!.env.example",
      "!**/*.md"
    ],
    "win": {
      "target": "dir"
    }
  }
}
